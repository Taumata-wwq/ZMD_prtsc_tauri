{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "终末地截图工具",
  "version": "3.1.0",
  "identifier": "com.zmd.prtsc.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "终末地截图工具",
        "width": 900,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "终末地俯瞰模式截图工具",
    "longDescription": "终末地俯瞰模式截图工具 - Tauri 重构版"
  }
}
